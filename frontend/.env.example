# 검색 API 주소 (레포 루트에서 scripts/serve/run_api 로 실행). 복사해서 .env.local 로 쓰세요.
# 로컬 개발에는 꼭 넣는다. 비우면 배포용 기본값 /api(같은 주소)로 불러서 개발 서버에서는 연결되지 않는다.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# 휴대폰 테스트 시 PC의 LAN IP로 바꿉니다 (localhost는 폰 자신을 가리킴)
# NEXT_PUBLIC_API_BASE_URL=http://192.168.0.10:8000
# 웹/앱 화면 선택: auto(기본, 768px 이상 웹) | app(하이브리드 앱 빌드) | web
# NEXT_PUBLIC_VIEW_MODE=auto
