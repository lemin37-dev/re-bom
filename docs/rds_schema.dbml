// Re:봄 서비스 DB(RDS PostgreSQL + pgvector) v0.1 — dbdiagram.io 용 DBML
// 2026-11-25 · 기준: 노션 "Gold 스키마 · 확정 규칙과 사진 임베딩 설계안"(11/22~) RDS 절, develop eb4e317
// 쓰는 법: dbdiagram.io 편집 창에 통째로 붙여 넣기. 표 설명 = Table [note], 칼럼 설명·예시 = 칼럼 note('예:' 줄), 값 목록 = Enum.
// 관리: 이 파일 = 표·칼럼 설명과 값 목록의 원본(그림은 dbdiagram.io 에 붙여 넣어 봄). 실제 DB = db/migrations/*.sql (dbdiagram export SQL 은 쓰지 않음)
// 버전: 스키마 v0.1 = 마이그레이션 001~006. develop 머지 때 Actions(schema-version.yml)가 태그 schema-v0.1 을 담. 새 마이그레이션이면 번호를 고치고 태그가 이미 있으면 버전을 올림. RDS 적용 상태는 schema_migrations 표
// 실제 DB 타입: enum 으로 표시한 칼럼은 실제로는 text/varchar + CHECK. 칼럼 이름이 마이그레이션과 같은지 tests/test_rds_schema_doc.py 가 확인함
// 벡터 표 2개(image_embedding·text_embedding)는 004 에서 지우고 이 모양으로 다시 만듦(11/25: RDS 데이터 비우고 S3 동기화 처음부터, HNSW 없음)

// ───────── 값 목록 (Enum) ─────────

// 공고 상태 묶음 (Silver cleaning/status.py)
Enum status_group {
  "PROTECTING" [note: '보호중. 검색 대상']
  "CLOSED" [note: '종료(입양·반환·자연사·안락사·기증·방사·사유 미상)']
  "UNKNOWN" [note: '상태 없음·예상 밖 값']
}

// 종료 사유 (Silver closure_reason_code)
Enum closure_reason {
  "입양" [note: '입양']
  "반환" [note: '반환']
  "자연사" [note: '자연사']
  "안락사" [note: '안락사']
  "기증" [note: '기증']
  "방사" [note: '방사']
  "사유 미상" [note: '사유 미상']
}

// 성별 (sexCd)
Enum sex_code {
  "M" [note: '수컷']
  "F" [note: '암컷']
  "Q" [note: '미상']
}

// 중성화 (neuterYn)
Enum neuter_code {
  "Y" [note: '예']
  "N" [note: '아니오']
  "U" [note: '미상']
}

// 축종 (upKindCd)
Enum species_code {
  "417000" [note: '개']
  "422400" [note: '고양이']
  "429900" [note: '기타축종']
}

// 크기 (개만, Silver 규칙)
Enum size {
  "small" [note: '10kg 이하']
  "medium" [note: '25kg 미만']
  "large" [note: '25kg 이상']
}

// 털색 계열 (color_tag 배열의 원소)
Enum color_group {
  "흰색계열" [note: '흰색계열']
  "검정계열" [note: '검정계열']
  "갈색계열" [note: '갈색계열']
  "노랑계열" [note: '노랑계열']
  "회색계열" [note: '회색계열']
  "기타" [note: '기타']
}

// 무늬 (color_pattern)
Enum color_pattern {
  "얼룩" [note: '얼룩']
  "줄무늬" [note: '줄무늬']
  "삼색" [note: '삼색']
  "턱시도" [note: '턱시도']
  "호구" [note: '호구']
  "호반" [note: '호반']
  "호피" [note: '호피']
  "반점" [note: '반점']
  "브린들" [note: '브린들']
}

// 태그·임베딩 작업 이름 (version 앞부분)
Enum tag_task {
  "photo_trait" [note: '사진 외형(털·귀·눈매)']
  "photo_breed" [note: '사진 닮은 품종']
  "text_personality" [note: '공고 글 성격 (Jev)']
  "text_health" [note: '공고 글 건강정보 (Jev)']
  "image_embedding" [note: '사진 벡터']
  "text_embedding" [note: '글 카드 벡터']
}

// 태그 출처 (11/24, Gold 옛 값 jev → text)
Enum tag_source {
  "photo" [note: '사진']
  "text" [note: '공고 글']
  "rule" [note: '공고 칸 규칙']
}

// 결과 대상 종류
Enum subject_type {
  "photo" [note: '사진 sha256 단위 결과']
  "animal" [note: '공고번호 단위 결과']
}

// 태그 코드 (tagging/tag_codes.py · text_tags.py). 귀염(인상)은 목록에 없음: 태깅하지 않고 검색 태그로 만들지 않음(11/16·11/19 결정, RDS CHECK 로도 막음)
Enum tag_code {
  "fur.fluffy" [note: '복슬복슬 · photo_trait · 검색O 화면O']
  "fur.short" [note: '짧은 털 · photo_trait · 검색O 화면O']
  "ear.drop" [note: '늘어진 귀 · photo_trait']
  "ear.semi" [note: '반쯤 선 귀 · photo_trait']
  "ear.prick" [note: '선 귀 · photo_trait']
  "eye.round" [note: '둥근 눈매 · photo_trait']
  "eye.sharp" [note: '날카로운 눈매 · photo_trait']
  "personality.gentle" [note: '순함 · text_personality (확률 0.75 이상)']
  "personality.friendly" [note: '친화적 · text_personality']
  "personality.timid" [note: '겁많음 · text_personality']
  "personality.wary" [note: '경계 · text_personality']
  "personality.active" [note: '활발 · text_personality']
  "personality.aggressive" [note: '사나움 · text_personality']
  "personality.sensitive" [note: '예민 · text_personality']
  "personality.curious" [note: '호기심 · text_personality']
  "health.info" [note: '건강정보 있음 · text_health']
  "health.none" [note: '건강정보 없음(건강하다는 뜻 아님) · text_health']
  "breed.<품종>" [note: '닮은 품종 · photo_breed · 화면X, 유사도 90 이상만 검색. 품종 이름은 열린 값(예시: breed_name_examples)']
}

// [열린 값 · 닫힌 목록 아님] breed.<품종> 의 품종 이름 예시. 품종 태깅은 모델 지식(전체 품종)으로 고르고 기준표 없음(11/23 확인). 아래 62종은 3년치 빈도 후보(breed_candidates_3y.json)로, 이름 표기 맞추기에만 씀. 목록 밖 품종도 모델이 쓴 이름 그대로 태그가 됨
