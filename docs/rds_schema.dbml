// 동기화 경로 (11/23 동기화 분리)
Enum sync_route {
  "notice_status" [note: '공고 상태. Silver 공고 적재 성공 뒤, 사진 안 기다림']
  "photo_vector" [note: '사진·벡터. 공고·사진 공통 완료본 뒤']
  "tag" [note: '태그']
  "text_vector" [note: '글 벡터']
}

// 마이그레이션 기록 방식 (schema_migrations.how)
Enum migration_how {
  "apply" [note: '도구가 파일을 실행하고 기록']
  "baseline" [note: '표가 생기기 전에 손으로 적용한 파일의 기록만 넣음']
}

// ───────── 표 ─────────

Table service_notice [note: '''공고 화면의 기준 행(공고당 1행). 검색은 PROTECTING 만, 상세는 PROTECTING 이거나 visible_until 이 지나지 않은 종료 공고. 공개 필드만, 보호자 실명(careOwnerNm)·동물등록번호 없음. 원천: Silver silver_animal_notice + silver_shelter'''] {
  desertion_no varchar(20) [pk, note: '''공고 고유키 (API desertionNo)
예: 448567202600123''']
  notice_no text [note: '''공고번호 문자열 (noticeNo)
예: 충남-당진-2026-00542''']
  status_group status_group [not null, note: '''공고 상태. Silver 값 그대로, RDS 가 판단하지 않음. 공고 상태 동기화 경로만 고침
예: PROTECTING''']
  process_state_raw text [note: '''상태 원문. 상세에 그대로 표시
예: 보호중 / 종료(입양)''']
  closure_reason_code closure_reason [note: '''종료 사유. 바뀌어도 30일 연장 안 함
예: 입양''']
  closed_transition_at timestamptz [note: '''서비스 시작 이후 보호중→종료를 처음 확인한 시각. 같은 종료 재처리 시 유지, 보호중 복귀 시 비움 (출처는 광훈 님 확인 대기)
예: 2026-11-24 03:12:00+09''']
  visible_until timestamptz [note: '''상세 노출 만료 = closed_transition_at + 30일. 재동기화로 늘리지 않음. 서비스 시작 전 종료 공고는 NULL(비노출)
예: 2026-12-24 03:12:00+09''']
  species_code species_code [not null, note: '''축종 코드. 벡터 검색의 종 필터는 이 칼럼과 JOIN (벡터 표에 복사 안 함)
예: 417000''']
  species_name text [note: '''축종 이름 (upKindNm)
예: 개''']
  breed_code varchar(10) [note: '''품종 코드 (kindCd, 앞자리 0 보존)
예: 000114''']
  breed_name_raw text [note: '''품종 원문 (kindNm). 화면 품종은 이 값 (태깅 결과 아님)
예: 믹스견''']
  breed_full_name_raw text [note: '''kindFullNm. 기타 축종은 여기에만 실제 이름
예: [개] 믹스견''']
  is_mix boolean [note: '''믹스 여부 (코드 000114 등 또는 이름에 '믹스')
예: true''']
  sex_code sex_code [note: '''성별
예: F''']
  neuter_code neuter_code [note: '''중성화
예: U''']
  birth_year smallint [note: '''출생연도. 화면은 'N년생'만, 나이는 안 보여 줌
예: 2024''']
  weight_raw text [note: '''체중 원문 (화면 표시)
예: 9.00(Kg)''']
  weight_kg numeric(6,2) [note: '''체중 kg (범위면 큰 값)
예: 9.00''']
  size size [note: '''크기 (개만). 크기 필터
예: small''']
  color_raw text [note: '''털색 원문 (colorCd)
예: 갈색&검정''']
  color_tag "text[]" [note: '''털색 계열 배열 (값은 color_group). 털색 필터
예: {갈색계열,검정계열}''']
  color_pattern color_pattern [note: '''무늬. 없으면 NULL
예: 얼룩''']
  special_mark text [note: '''특이사항 원문 (specialMark)
예: 온순. 겁 조금.''']
  sfe_soci text [note: '''특징(사회성) 원문. 상세 성격 자리
예: 사람을 잘 따름''']
  sfe_health text [note: '''특징(건강) 원문
예: 피부병 치료 중''']
  health_chk text [note: '''건강 체크 원문 (healthChk)''']
  vaccination_chk text [note: '''접종 체크 원문 (vaccinationChk)''']
  happen_date date [note: '''접수일 (happenDt)
예: 2026-11-10''']
  happen_place text [note: '''발견 장소 원문. 화면은 읍·면·동/구까지만
예: 당진시 용연동''']
  org_name text [note: '''관할 기관 (orgNm)
예: 충청남도 당진시''']
  notice_start_date date [note: '''공고 시작일 (noticeSdt)
예: 2026-11-11''']
  notice_end_date date [note: '''공고 종료일 (noticeEdt)
예: 2026-11-23''']
  care_reg_no varchar(20) [note: '''보호소 등록번호 (보호소 표는 따로 두지 않고 공고에 펼침)
예: 344500202100001''']
  care_name text [note: '''보호소 이름
예: 당진시동물보호소''']
  care_tel text [note: '''보호소 전화. 화면 표시(11/20 결정), 검색 로그로 보내지 않음
예: 000-0000-0000''']
  care_address text [note: '''보호소 주소
예: 충청남도 당진시 ○○로 00''']
  content_hash char(64) [not null, note: '''옮긴 칼럼 값의 sha256. 같으면 UPDATE 건너뜀(재반영 무해)
예: 9f2c…e1a0 (64자)''']
  silver_publish_seq bigint [note: '''이 행을 쓴 Silver 완료본 순번 (silver_run_id 방식이 정해지면 교체)
예: 42''']
  synced_at timestamptz [not null, note: '''RDS 반영 시각
예: 2026-11-25 04:00:00+09''']
}

Table service_notice_photo [note: '''공고 화면에 보여줄 사진 칸(칸당 1행). 원천: Silver 현재 사진 표시 키. emptied 확정 칸은 행 삭제, 종료 공고는 마지막 확인 사진 유지'''] {
  desertion_no varchar(20) [not null, note: '''공고번호
예: 448567202600123''']
  image_slot smallint [not null, note: '''popfile 칸 1~8. 대표 사진 = 키가 있는 가장 작은 칸
예: 1''']
  sha256 char(64) [not null, note: '''표시 중인 원본 사진 sha256. 태그·벡터가 지금 사진 것인지 확인하는 키
예: 3b7a…c90d (64자)''']
  photo_version smallint [not null, note: '''사진 교체 순번 (Silver current_version)
예: 2''']
  serving_s3_key text [not null, note: '''화면 이미지 키 (CloudFront /images/*)
예: serving/rescue/images/448567202600123/popfile1_v002.webp''']
  thumb_s3_key text [note: '''썸네일 키 (~400px WebP)
예: thumb/rescue/images/448567202600123/popfile1_v002.webp''']
  silver_publish_seq bigint [note: '''이 행을 쓴 Silver 공통 완료본 순번
예: 42''']
  synced_at timestamptz [not null, note: '''RDS 반영 시각''']
  indexes {
    (desertion_no, image_slot) [pk]
  }
}

Table service_notice_tag [note: '''공고에 연결한 태그 1개 = 1행. Gold gold_animal_tag 중 활성 버전 + 현재 입력(대표 사진 sha256 / 최신 글 해시)만. 검색은 보호중 공고의 searchable, 상세는 displayable'''] {
  desertion_no varchar(20) [not null, note: '''공고번호
예: 448567202600123''']
  subject_type subject_type [not null, note: '''결과 대상 종류
예: photo''']
  subject_key varchar(64) [not null, note: '''photo 면 대표 사진 sha256 (service_notice_photo.sha256 과 같아야 함), animal 이면 공고번호
예: 3b7a…c90d''']
  task tag_task [not null, note: '''태그를 만든 작업
예: photo_trait''']
  tag_code tag_code [not null, note: '''태그 코드 (목록은 Enum tag_code)
예: ear.drop''']
  tag_label text [not null, note: '''화면 이름 (적재 때 tag_codes.py 라벨 복사)
예: 늘어진 귀''']
  version varchar(64) [not null, note: '''이 태그를 만든 버전 task@N. active_version 과 같아야 검색·표시
예: photo_trait@1''']
  source tag_source [not null, note: '''출처
예: photo''']
  searchable boolean [not null, note: '''검색에 쓰는지 (Gold 행 값). 품종은 유사도 90 이상만 true
예: true''']
  displayable boolean [not null, note: '''화면에 보이는지 (Gold 행 값). breed.* 는 false
예: true''']
  rank smallint [note: '''품종 순위 1~3 (photo_breed 만)
예: 1''']
  similarity smallint [note: '''품종 유사도 평균 또는 Jev 확률×100. 화면 비표시
예: 92''']
  gold_run_id text [note: '''Gold 실행 ID (추적용)
예: photo-tags-20261123T0300''']
  synced_at timestamptz [not null, note: '''RDS 반영 시각''']
  indexes {
    (desertion_no, subject_type, subject_key, task, tag_code) [pk]
  }
}

Table image_embedding [note: '''공고 현재 사진 칸의 검색 벡터(칸 × 버전). Gold gold_image_embedding(sha256 단위)을 칸에 펼침. 검색 후보 = 보호중 + sha256 일치 + 활성 버전. 키에 version 포함(004). 모델 등 실행 설정은 version 의 레지스트리 설정에만 두고 행에 적지 않음(006). v0.1 인덱스 없음(전체 비교), HNSW 는 실측 뒤 v0.2 에서 검토'''] {
  desertion_no varchar(20) [not null, note: '''공고번호
예: 448567202600123''']
  image_slot smallint [not null, note: '''사진 칸 1~8
예: 1''']
  version varchar(64) [not null, note: '''image_embedding@N. 키에 포함해 같은 모델 v1·v2 공존
예: image_embedding@1''']
  photo_version smallint [not null, note: '''사진 교체 순번
예: 2''']
  sha256 char(64) [not null, note: '''임베딩한 원본 sha256. service_notice_photo.sha256 과 다르면 검색 후보에서 제외
예: 3b7a…c90d''']
  s3_key text [not null, note: '''임베딩한 원본 키
예: bronze/rescue/images/448567202600123/popfile1_v002.jpg''']
  photo_run_id text [not null, note: '''사진 실행 run_id
예: 20261124T030000-ab12''']
  gold_run_id text [note: '''Gold 실행 ID''']
  embedding vector(768) [not null, note: '''768차원 벡터, 코사인 거리. v0.1 인덱스 없음
예: [0.012, -0.034, …] (768개)''']
  embedded_at timestamptz [not null, note: '''RDS 적재 시각''']
  indexes {
    (desertion_no, image_slot, version) [pk]
  }
}

Table text_embedding [note: '''공고 카드의 글 검색 벡터(공고 × 버전). Gold gold_text_embedding 중 현재 카드 해시와 맞는 1행. 키에 version 포함(004). 모델·카드 템플릿(Gold prompt_version)·태그 버전은 version 의 레지스트리 설정에만 두고 행에 적지 않음(006). v0.1 인덱스 없음'''] {
  desertion_no varchar(20) [not null, note: '''공고번호
예: 448567202600123''']
  text_kind varchar(10) [not null, note: '''글 종류 (지금은 card 하나)
예: card''']
  version varchar(64) [not null, note: '''text_embedding@N (템플릿 내용·지문·태그 버전 포함 설정)
예: text_embedding@3''']
  text_sha256 char(64) [not null, note: '''가린 카드 본문 sha256 (Gold source_hash)
예: 4547c5…6206''']
  gold_run_id text [note: '''Gold 실행 ID
예: text-737c35ec…''']
  embedding vector(768) [not null, note: '''768차원 벡터. v0.1 은 인덱스 없이 전체 비교''']
  embedded_at timestamptz [not null, note: '''RDS 적재 시각''']
  indexes {
    (desertion_no, text_kind, version) [pk]
  }
}

Table active_version [note: '''작업별 서비스 활성 버전(작업당 1행). 일일 배치는 시작 때 한 번 읽어 고정, 검색 API 는 한 요청 안에서 활성값·질의 설정·벡터를 함께 씀. 전환·롤백은 사람이 (11/23 기준안, 칼럼은 제안)'''] {
  task tag_task [pk, note: '''작업 이름
예: image_embedding''']
  version varchar(64) [not null, note: '''활성 버전 (Gold gold_version_registry 등록값)
예: image_embedding@1''']
  config_hash char(64) [not null, note: '''Gold 레지스트리 config_hash. 전환 때 대조''']
  query_config jsonb [note: '''검색에 필요한 설정(질의 모델·차원 등). 원본은 Gold 레지스트리
예: {"model": "gemini-embedding-2", "dim": 768}''']
  previous_version varchar(64) [note: '''직전 활성 버전 (롤백용)
예: image_embedding@0''']
  activated_at timestamptz [not null, note: '''전환 시각''']
  activated_by text [not null, note: '''전환한 사람
예: lemin''']
}

Table sync_state [note: '''동기화 경로별 마지막 반영 Silver 완료본 (워터마크 대신, 11/23 제안). 더 오래된 완료본은 반영 안 함. 순번 비교와 행 변경은 같은 트랜잭션 (표 자체가 제안)'''] {
  route sync_route [pk, note: '''동기화 경로
예: photo_vector''']
  last_publish_seq bigint [note: '''silver_publish_log 방식일 때 마지막 반영 순번
예: 42''']
  last_silver_run_id text [note: '''journal COMPLETED 방식일 때 마지막 반영 실행. 둘 중 하나만 씀(미정)
예: silver_20261124T030012-f65718''']
  notice_snapshot_id bigint [note: '''읽은 Silver 공고 Iceberg 스냅샷
예: 5620324469304075651''']
  image_snapshot_id bigint [note: '''읽은 Silver 현재 사진 Iceberg 스냅샷
예: 800755379067985557''']
  applied_at timestamptz [not null, note: '''반영 완료 시각''']
}

// ───────── 영역 (TableGroup) ─────────
TableGroup notice_screen [color: #2E7D32, note: '공고 화면 영역. Silver 공고·현재 사진과 Gold 태그를 공고 단위로 펼친 표. 상세·목록·필터 검색이 읽음'] {
  service_notice
  service_notice_photo
  service_notice_tag
}

TableGroup search_vector [color: #1565C0, note: '검색 벡터 영역 (pgvector). Gold 임베딩 결과 중 활성 버전·현재 사진/카드와 맞는 행만. 사진·자연어 유사도 검색이 읽음'] {
  image_embedding
  text_embedding
}

TableGroup ops [color: #757575, note: '운영 영역. 서비스 활성 버전, 동기화 순번, 마이그레이션 적용 기록. 화면에 직접 쓰지 않음'] {
  active_version
  sync_state
  schema_migrations
}


Table schema_migrations [note: '''마이그레이션 적용 기록(파일당 1행). python -m rebom.common.migrate 가 쓴다. 적용한 파일 내용이 레포와 다르면 도구가 멈춤'''] {
  filename text [pk, note: '''db/migrations 파일 이름
예: 004_vector_tables_v01.sql''']
  sha256 char(64) [not null, note: '''적용할 때 파일 내용(UTF-8, 줄바꿈 LF 기준)의 sha256. 레포 파일과 다르면 적용 뒤 파일이 고쳐진 것
예: 9f2c…e1a0 (64자)''']
  applied_at timestamptz [not null, default: `now()`, note: '''적용(또는 기록) 시각
예: 2026-11-25 14:10:00+09''']
  applied_by text [not null, note: '''적용한 사람 (--by, 없으면 PC 사용자 이름)
예: lemin''']
  how migration_how [not null, note: '''apply = 도구가 실행, baseline = 이미 손으로 적용한 파일의 기록만 넣음
예: apply''']
}

Ref: service_notice_photo.desertion_no > service_notice.desertion_no [delete: cascade]
Ref: service_notice_tag.desertion_no > service_notice.desertion_no [delete: cascade]
Ref: image_embedding.(desertion_no, image_slot) > service_notice_photo.(desertion_no, image_slot) [delete: cascade]
Ref: text_embedding.desertion_no > service_notice.desertion_no [delete: cascade]
