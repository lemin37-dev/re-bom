// Re:봄 운영 기록 (RDS PostgreSQL ops 스키마, 새로 만듦) — dbdiagram.io 용 DBML
// 2026-11-27 · 운영 모니터링 화면 설계안(v0.2) 결정: 운영 기록은 RDS ops 스키마, 마이그레이션 008 (아직 없음, 2단계 feat/common-ops-log 에서 추가)
// 관리: 표·칼럼 설명과 원인 코드 목록의 원본. 실제 구조의 원본은 마이그레이션 008 이 될 예정이다(그때 tests 의 비교 대상에 넣음)
// 쓰는 곳: 각 단계가 끝날 때 ops_run_summary 한 줄, 실패를 만나면 ops_failure 한 줄. 기록 쓰기가 실패해도 본 작업은 그대로 진행
// Gold 모델 실패는 여기 복사하지 않고 gold_inference_log·gold_model_request_log 를 gold_run_id 로 바로 읽는다
// 버전: 머리 줄 버전 번호 없음. RDS 는 schema_migrations 번호, 표 구조는 칼럼 지문으로 비교
// 개인정보: evidence 에도 보호자 실명·연락처를 넣지 않는다. 화면은 공고번호·칸·구간만 보여 준다

// ───────── 값 목록 (Enum) ─────────

// 단계 (ops_run_summary.stage, ops_failure.stage). Gold·RDS 는 작업·경로 이름을 붙인다
Enum ops_stage {
  "bronze" [note: 'Bronze 수집 (manifest)']
  "photo" [note: '사진 다운로드·현재 사진 스냅샷']
  "silver_notice" [note: 'Silver 공고·상태 이력']
  "silver_photo" [note: 'Silver 현재 사진·사진 이력']
  "silver_publish" [note: 'Silver READY 발행']
  "gold_<task>" [note: 'Gold 작업별 (예: gold_photo_trait, gold_image_embedding). 실패 건은 Gold 로그를 읽음']
  "rds_<route>" [note: 'RDS 동기화 경로별 (sync_route 값: rds_notice_status, rds_photo_vector, rds_tag, rds_text_vector)']
}

// 단계 결과
Enum ops_run_status {
  "ok" [note: '끝남, 실패 없음']
  "warn" [note: '끝났지만 실패·보류 건이 있음']
  "failed" [note: '단계가 멈춤 (뒤 단계는 skipped)']
  "skipped" [note: '앞 단계 실패나 설정 꺼짐으로 돌지 않음']
}

// 원인 코드. 값은 코드에 이미 있는 값을 그대로 쓰고, note 에 화면용 설명 · 조치 한 줄
Enum ops_reason_code {
  "aborted" [note: 'Bronze 실행 중단(보호중 목록 0건 등). 상태 갱신 안 함 · 다음 실행이 같은 범위를 다시 받음']
  "count_mismatch" [note: '구간 total 과 받은 건수가 다름 · 자동: 다음 실행이 다시 받음']
  "dropped_row" [note: '형식이 틀려 버린 항목 · 사람 확인 (원문 구간 보기)']
  "not_found" [note: '사진 주소 404 · 자동: 5일 뒤 한 번 재확인, 그래도 404 면 gave_up']
  "replaced_not_found" [note: '새로 바뀐 사진 주소가 404. 옛 버전 유지 · 자동: 5일 뒤 재확인']
  "gave_up" [note: '사진을 정해진 횟수만큼 실패 · 사람 확인 (다시 시도하지 않음)']
  "raw_content_conflict" [note: '같은 공고가 두 목록에서 다른 원본으로 옴. Silver 실행 차단 · 사람 확인 (자동 병합 안 함)']
  "silver_transform_conflict" [note: '같은 공고의 정제 결과가 서로 다름. Silver 실행 차단 · 사람 확인']
  "partition_incomplete" [note: '미완료 구간이 있어 Silver 가 시작하지 않음 · 자동: 다음 수집 뒤 재실행']
  "publish_blocked" [note: 'READY 조건 미충족(NOTICE_NOT_COMPLETED 등 publish_log 사유) · 앞 단계 확인']
  "stale_input" [note: 'RDS 동기화: 이미 반영한 발행보다 오래된 입력 (종료 코드 4) · 자동: 건너뜀']
  "config_hash_mismatch" [note: 'RDS 동기화: 레지스트리 config_hash 와 active_version 이 다름 · 사람: 활성 버전 전환 절차(data_contract 16.2)']
  "no_active_version" [note: 'RDS 동기화: 작업의 활성 버전이 없음 · 사람: 활성 버전 등록']
  "fk_skipped" [note: 'RDS 동기화: 부모 행이 없어 건너뛴 행 · 자동: 공고 경로 반영 뒤 다시']
}

// ───────── 표 ─────────

Table ops_run_summary [note: '''실행 1번의 단계 1개 = 1행. 탭1 핵심 숫자 카드와 단계 흐름도의 숫자. 지금은 실행 중 메모리에만 있는 Silver insert·update·충돌 수와 RDS 동기화 결과를 여기 남긴다. "오늘" = 마지막으로 성공한 Bronze 실행(rescue_state.last_run_id)'''] {
  id bigserial [pk, note: '''행 번호
예: 1042''']
  env text [not null, note: '''환경 test · prod
예: test''']
  bronze_run_id text [not null, note: '''이 실행의 Bronze 수집 id. 하루 실행을 묶는 키
예: 20261127T030011-9c41a2''']
  publish_id text [note: '''Silver 발행 id (발행 이후 단계만)
예: silver_20261127T030011-9c41a2''']
  gold_run_id text [note: '''Gold 실행 id (gold_<task> 단계만)
예: photo-20261127T040211''']
  stage ops_stage [not null, note: '''단계
예: gold_photo_trait''']
  status ops_run_status [not null, note: '''단계 결과
예: warn''']
  started_at timestamptz [not null, note: '''시작 시각
예: 2026-11-27 04:02:11+09''']
  finished_at timestamptz [note: '''끝난 시각
예: 2026-11-27 04:10:40+09''']
  input_count integer [note: '''들어온 건수
예: 212''']
  output_count integer [note: '''내보낸 건수
예: 205''']
  failed_count integer [note: '''실패 건수 (값 보류는 세지 않음)
예: 7''']
  stats jsonb [note: '''단계별 세부: insert·update·unchanged, 상태 쌍별 건수, 파싱 보류 분포, 호출 수·비용, 동기화 반영 수
예: {"insert":286,"update":512,"transitions":{"보호중→종료(입양)":198},"weight_parse":{"ambiguous":61}}''']
  code_version text [note: '''단계를 돌린 코드·이미지 버전
예: feeddb8''']
  created_at timestamptz [not null, default: `now()`, note: '''기록 시각
예: 2026-11-27 04:10:41+09''']
  indexes {
    (env, bronze_run_id, stage) [unique]
  }
}

Table ops_failure [note: '''실패한 대상 1개 = 1행. Bronze·사진·Silver·RDS 동기화가 실패를 만날 때 쓴다. 실패 드릴다운 원인별 → 건별 → 증거의 출처. 작업이 실패를 반환만 하고 멈추는 곳(Silver 충돌, RDS 종료 코드 4)은 멈추기 전에 쓴다'''] {
  id bigserial [pk, note: '''행 번호
예: 88''']
  env text [not null, note: '''환경
예: test''']
  bronze_run_id text [not null, note: '''실패를 만난 실행
예: 20261127T030011-9c41a2''']
  publish_id text [note: '''RDS 동기화 실패면 그 발행
예: silver_20261127T030011-9c41a2''']
  stage ops_stage [not null, note: '''실패한 단계
예: silver_notice''']
  subject_type text [not null, note: '''대상 종류: animal(공고) · photo_slot(공고·칸) · partition(수집 구간) · route(동기화 경로)
예: animal''']
  subject_key text [not null, note: '''대상 키. 공고면 desertion_no (공고 추적으로 이동)
예: 448567202600142''']
  reason_code ops_reason_code [not null, note: '''원인 코드
예: raw_content_conflict''']
  message text [note: '''오류 한 줄
예: sources differ: processState''']
  attempts integer [note: '''시도 횟수
예: 1''']
  evidence jsonb [note: '''원문 증거 (보호자 정보 제외): 충돌한 원본 종류와 다른 칼럼, 구간 결과 등
예: {"sources":["list_protect","updated"],"diff":{"processState":["보호중","종료(입양)"]}}''']
  evidence_ref text [note: '''원문 위치 (S3 키 · request_id)
예: bronze/rescue/raw/dt=2026-11-27/run_id=20261127T030011-9c41a2/updated.jsonl.gz''']
  blocking boolean [not null, default: false, note: '''실행을 멈춘 건인지. 탭1 정제 실패 카드는 이 값이 true 인 건만 센다
예: true''']
  observed_at timestamptz [not null, note: '''관측 시각
예: 2026-11-27 03:44:02+09''']
  indexes {
    (env, bronze_run_id, stage)
    (subject_key)
  }
}

Table ops_schema_snapshot [note: '''Silver·Gold Iceberg 표의 실제 구조를 관측한 기록. 요약 태스크가 실행마다 Glue 에서 읽어 바뀌었을 때만 1행 쓴다. API 는 이 표와 RDS information_schema 만 읽어 문서 지문(schema_catalog.json)과 비교하므로 API 파드에 Glue 권한이 필요 없다'''] {
  id bigserial [pk, note: '''행 번호
예: 17''']
  env text [not null, note: '''환경
예: test''']
  layer text [not null, note: '''silver · gold
예: gold''']
  table_name text [not null, note: '''문서 표 이름 (환경 접미사 뺀 이름)
예: gold_image_embedding''']
  physical_name text [not null, note: '''실제 Glue 표 이름
예: rebom_gold.gold_image_embedding_test''']
  schema_id integer [not null, note: '''Iceberg 현재 schema-id (칼럼이 바뀌면 Iceberg 가 올림)
예: 3''']
  fingerprint char(64) [not null, note: '''(칼럼 이름, 타입) 정렬 목록의 sha256. 문서 지문과 같은 방식
예: 9b27…4c18''']
  columns jsonb [not null, note: '''칼럼 이름·타입 목록
예: [["subject_type","string"],["subject_key","string"]]''']
  observed_at timestamptz [not null, note: '''관측 시각
예: 2026-11-27 03:58:00+09''']
  bronze_run_id text [note: '''관측한 실행
예: 20261127T030011-9c41a2''']
  indexes {
    (env, table_name, observed_at)
  }
}

// ───────── 영역 (TableGroup) ─────────
// RDS 문서의 TableGroup ops(active_version 등)와 이름이 겹치지 않게 ops_record 로 둔다
TableGroup ops_record [color: #757575, note: '운영 기록 (RDS ops 스키마). 실행 요약·실패·Iceberg 구조 관측. 서비스 화면에는 쓰지 않고 /ops 운영 화면만 읽음'] {
  ops_run_summary
  ops_failure
  ops_schema_snapshot
}
