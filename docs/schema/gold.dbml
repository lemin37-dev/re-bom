// Re:봄 Gold 층 (Iceberg rebom_gold, 모델 결과와 로그) — dbdiagram.io 용 DBML
// 2026-11-27 · 기준 develop feeddb8 · 운영 화면 탭2(테이블 흐름)·탭1(모델 추적) 원본
// 관리: 표·칼럼 설명과 예시의 원본. 실제 구조의 원본은 src/rebom/common/gold_catalog.py 의 schemas(). 이름이 같은지 tests/test_pipeline_schema_doc.py 가 확인함
// 환경: test 는 이름 뒤에 _test (s3://…/gold/_test/iceberg), prod 는 그대로 (s3://…/gold/iceberg)
// 공용 키: (subject_type, subject_key). photo → 사진 원본 sha256, animal → 공고번호. 같은 사진은 공고가 달라도 한 번만 처리
// 버전: 머리 줄 버전 번호 없음. 표 구조는 Iceberg schema-id, 모델 실행 설정은 gold_version_registry 의 task@N 과 config_hash
// 표기: 외래키 없음. 층 사이·표 사이 연결은 links.dbml

// ───────── 값 목록 (Enum) ─────────

// 처리 상태 (gold_inference_log.status)
Enum gold_inference_status {
  "OK" [note: '결과를 만듦. 끝남(다시 부르지 않음)']
  "NO_RESULT" [note: '모델이 답했지만 채택할 결과가 없음. 끝남']
  "NO_PHOTO" [note: '사진이 없는 공고. 끝남']
  "BAD_IMAGE" [note: '사진을 열 수 없음. 끝남. detail 에 s3_key·error']
  "BLANK" [note: '흰·빈 사진 (사진 임베딩). detail 에 gray_std·blank_std']
  "FAILED" [note: '모델 호출·답 형식 실패. MAX_ATTEMPTS 번까지 다시 부름']
  "READ_ERROR" [note: 'S3 원본을 못 읽음. 매 실행 다시 봄(모델 안 불러 비용 없음), attempts = 연속 실패 횟수']
  "SHA_MISMATCH" [note: '받은 파일의 sha256 이 Silver 값과 다름. 매 실행 다시 봄']
}

// ───────── 표 ─────────

Table gold_run_input [note: '''Gold 실행 1번이 어느 Silver 발행본과 어느 버전으로 돌았는지. 새 결과가 0건이어도 시작 기록을 남긴다. 운영 화면 모델 추적에서 실행 → 발행본을 잇는 표'''] {
  gold_run_id string [pk, note: '''Gold 실행 id
예: photo-20261127T040211''']
  publish_id string [not null, note: '''읽은 Silver 발행본
예: silver_20261127T030011-9c41a2''']
  task string [not null, note: '''작업: photo_trait · photo_breed · image_embedding · text_personality · text_health · text_embedding
예: photo_trait''']
  version string [not null, note: '''실행 설정 버전 task@N
예: photo_trait@1''']
  started_at timestamptz [not null, note: '''시작 시각
예: 2026-11-27 04:02:11+09''']
}

Table gold_version_registry [note: '''작업별 실행 설정. 같은 설정이면 같은 행, 바뀌면 새 번호. config_hash = 정렬한 config_json 의 sha256 이고, RDS active_version.config_hash 와 비교해 서비스 활성 여부를 판단한다'''] {
  task string [not null, note: '''작업
예: text_embedding''']
  version string [not null, note: '''task@N
예: text_embedding@3''']
  config_json string [not null, note: '''모델·질문지·전후처리·차원 JSON (비밀값 없음)
예: {"model_id":"gemini-embedding-2","dim":768,"template":"A2"}''']
  config_hash string [not null, note: '''설정 sha256 (64자)
예: 1a7e…5b33''']
  registered_at timestamptz [not null, note: '''처음 등록한 시각
예: 2026-11-24 10:12:00+09''']
  indexes {
    (task, version) [pk]
  }
}

Table gold_inference_log [note: '''대상·작업·버전·입력당 처리 상태 1행 (태깅·임베딩 공용). (subject_type, subject_key, task, version, input_hash) 로 upsert. 모델 처리 실패 드릴다운의 출처라 운영 기록(ops_failure)으로 복사하지 않고 gold_run_id 로 바로 읽는다'''] {
  subject_type string [not null, note: '''photo · animal
예: photo''']
  subject_key string [not null, note: '''사진 sha256 또는 공고번호
예: 3b7a…c90d''']
  task string [not null, note: '''작업
예: image_embedding''']
  version string [not null, note: '''task@N
예: image_embedding@1''']
  input_hash string [not null, note: '''실제 모델 입력의 해시 (사진은 sha256, 글은 카드 해시)
예: 3b7a…c90d''']
  status gold_inference_status [note: '''처리 결과
예: BAD_IMAGE''']
  attempts int [note: '''시도 횟수
예: 1''']
  tag_count int [note: '''만든 태그 수 (임베딩은 비움)
예: null''']
  last_error string [note: '''마지막 오류 한 줄
예: cannot identify image file''']
  gold_run_id string [note: '''마지막으로 처리한 Gold 실행
예: image-20261127T041102''']
  gold_updated_at timestamptz [note: '''상태 갱신 시각
예: 2026-11-27 04:16:03+09''']
  detail string [note: '''판정 근거 JSON. BLANK: {"gray_std","blank_std"}, 실패: {"s3_key","error"}
예: {"s3_key":"bronze/rescue/images/448567202600131/popfile1_v002.jpg","error":"cannot identify image file"}''']
  indexes {
    (subject_type, subject_key, task, version, input_hash) [pk]
  }
}

Table gold_model_request_log [note: '''모델 API 요청 1번 = 1행 (append 만, dt 파티션). 요청 모델과 실제 응답 모델·공급자·토큰·비용·지연·오류·답 원문. 묶어 보내면 subject_key = 첫 대상이고 비용·토큰은 요청 전체 값. 탭1 모델 추적의 비용·지연 출처'''] {
  request_id string [note: '''공급자 요청 id
예: gen-1764201542-Xk2…''']
  subject_type string [note: '''photo · animal
예: photo''']
  subject_key string [note: '''대상 (묶음 요청이면 첫 대상)
예: 9e41…b2d0''']
  task string [note: '''작업
예: photo_trait''']
  prompt_version string [note: '''질문지·템플릿·전처리 버전
예: trait-vision-v10''']
  run_no int [note: '''같은 대상의 몇 번째 호출 (2회 일치 판정 등)
예: 1''']
  requested_model string [note: '''요청한 모델
예: google/gemini-3.1-flash-lite''']
  response_model string [note: '''실제 응답한 모델. 요청과 다르면 화면에 표시
예: google/gemini-3.1-flash-lite''']
  provider string [note: '''응답한 공급자
예: Google AI Studio''']
  canonical_slug string [note: '''공급자 쪽 고정 모델 이름
예: google/gemini-3.1-flash-lite-20261015''']
  media_resolution string [note: '''사진 해상도 설정
예: MEDIUM''']
  prompt_tokens int [note: '''입력 토큰
예: 1290''']
  completion_tokens int [note: '''출력 토큰
예: 42''']
  reasoning_tokens int [note: '''추론 토큰
예: 0''']
  cost_usd double [note: '''요청 비용 (OpenRouter usage.cost 그대로)
예: 0.0031''']
  latency_ms bigint [note: '''지연
예: 1880''']
  attempts int [note: '''이 요청의 재시도 포함 시도 수
예: 1''']
  status string [note: '''OK · ERROR · BAD_ANSWER(답 형식 틀림)
예: OK''']
  error_code string [note: '''오류 코드 (HTTP 등)
예: 502''']
  raw_answer string [note: '''모델 답 원문 (길이 제한). 실패 증거
예: {"ear":"drop","eye":"round"}''']
  requested_at timestamptz [not null, note: '''요청 시각
예: 2026-11-27 04:09:12+09''']
  gold_run_id string [note: '''Gold 실행
예: photo-20261127T040211''']
  dt string [not null, note: '''requested_at 의 UTC 날짜 (파티션)
예: 2026-11-26''']
  temperature double [note: '''온도
예: 0.0''']
  reasoning_effort string [note: '''추론 강도 설정
예: null''']
  finish_reason string [note: '''끝난 이유 (정규화)
예: stop''']
  native_finish_reason string [note: '''공급자 원래 끝난 이유
예: STOP''']
  batch_size int [note: '''한 요청에 보낸 대상 수 (태깅은 비움 = 1)
예: null''']
  version string [note: '''task@N
예: photo_trait@1''']
}

Table gold_animal_tag [note: '''태그 1개 = 1행. 사진 태그는 사진 sha256, 글 태그는 공고번호가 키. 같은 대상·버전으로 다시 태깅할 때만 그 범위를 교체하고(글 태그는 version + source_hash, 데이터 계약 15.5), 이전 버전 태그는 남긴다. RDS service_notice_tag 의 원천'''] {
  subject_type string [not null, note: '''photo · animal
예: photo''']
  subject_key string [not null, note: '''사진 sha256 또는 공고번호
예: 3b7a…c90d''']
  tag_code string [not null, note: '''태그 코드 (docs/schema/rds.dbml Enum tag_code)
예: ear.drop''']
  source string [not null, note: '''출처 photo · text · rule (모델 이름 아님)
예: photo''']
  tagger_version string [not null, note: '''모델@질문지 버전
예: google/gemini-3.1-flash-lite@trait-vision-v10''']
  task string [not null, note: '''작업
예: photo_trait''']
  model string [note: '''쓴 모델
예: google/gemini-3.1-flash-lite''']
  prompt_version string [not null, note: '''질문지 버전
예: trait-vision-v10''']
  source_hash string [note: '''입력 해시
예: 3b7a…c90d''']
  searchable boolean [note: '''검색 태그로 쓰는지
예: true''']
  displayable boolean [note: '''상세 화면에 보여 주는지
예: true''']
  rank int [note: '''품종 순위 (photo_breed 만)
예: null''']
  similarity int [note: '''품종 유사도 0~100 (photo_breed 만)
예: null''']
  detail string [note: '''판정 근거 JSON
예: {"runs":["drop","drop"]}''']
  gold_run_id string [note: '''Gold 실행
예: photo-20261127T040211''']
  gold_updated_at timestamptz [note: '''만든 시각
예: 2026-11-27 04:10:02+09''']
  version string [note: '''레지스트리 등록 버전 task@N (사진·글 태그 모두)
예: photo_trait@1''']
  indexes {
    (subject_type, subject_key, task, prompt_version, tag_code) [pk]
  }
}

Table gold_image_embedding [note: '''사진 원본(sha256) 1장 × 모델 × 전처리 버전 = 벡터 1개. 같은 사진을 쓰는 공고·칸은 이 한 행을 같이 쓴다. RDS image_embedding 의 원천'''] {
  subject_type string [not null, note: '''photo
예: photo''']
  subject_key string [not null, note: '''사진 원본 sha256
예: 3b7a…c90d''']
  task string [not null, note: '''image_embedding
예: image_embedding''']
  model string [not null, note: '''모델:차원 (파티션)
예: gemini-embedding-2:768''']
  prompt_version string [not null, note: '''전처리 버전
예: exif-rgb-max1024-jpeg90''']
  source_hash string [not null, note: '''입력 해시 (사진은 subject_key 와 같음)
예: 3b7a…c90d''']
  embedding "list<float>" [not null, note: '''벡터
예: [0.012, -0.034, …] (768개)''']
  gold_run_id string [note: '''Gold 실행
예: image-20261127T041102''']
  gold_updated_at timestamptz [note: '''만든 시각
예: 2026-11-27 04:15:40+09''']
  version string [note: '''task@N
예: image_embedding@1''']
  indexes {
    (subject_type, subject_key, task, model, prompt_version) [pk]
  }
}

Table gold_text_embedding [note: '''공고 글 카드 1개 × 모델 × 템플릿 버전 × 카드 해시 = 벡터 1개. 카드 본문은 전화번호·관리번호를 가린 뒤 만들고, 보호자 실명·연락처는 들어가지 않는다. RDS text_embedding 의 원천'''] {
  subject_type string [not null, note: '''animal
예: animal''']
  subject_key string [not null, note: '''공고번호
예: 448567202600123''']
  task string [not null, note: '''text_embedding
예: text_embedding''']
  model string [not null, note: '''모델:차원 (파티션)
예: gemini-embedding-2:768''']
  prompt_version string [not null, note: '''글 카드 템플릿 버전
예: A2''']
  source_hash string [not null, note: '''가린 카드 본문 sha256
예: 7d10…a2c4''']
  input_text string [note: '''모델에 넣은 가린 카드 본문
예: 개 · 믹스견 · 2024년생 · 온순, 겁 조금''']
  source_update_dt string [note: '''카드를 만든 Silver 행의 source_updated_at_raw
예: 2026-11-26 14:02:11.0''']
  embedding "list<float>" [not null, note: '''벡터
예: [0.021, 0.007, …] (768개)''']
  gold_run_id string [note: '''Gold 실행
예: text-20261127T042010''']
  gold_updated_at timestamptz [note: '''만든 시각
예: 2026-11-27 04:21:33+09''']
  version string [note: '''task@N
예: text_embedding@3''']
  tag_versions string [note: '''카드에 넣은 태그의 버전 JSON
예: {"text_personality":"text_personality@1"}''']
  indexes {
    (subject_type, subject_key, task, model, prompt_version, source_hash) [pk]
  }
}

Table gold_embedding_canary [note: '''모델 변화 확인(canary) 1번 = 1행. 고정 사진 묶음의 벡터를 기준과 비교해 최소 코사인이 기준 이상이면 통과. 탭1 모델 추적의 canary 칸'''] {
  gold_run_id string [pk, note: '''canary-<시각>
예: canary-20261127T040005''']
  task string [not null, note: '''확인한 작업
예: image_embedding''']
  model string [not null, note: '''모델:차원
예: gemini-embedding-2:768''']
  prompt_version string [note: '''전처리 버전
예: exif-rgb-max1024-jpeg90''']
  checked_at timestamptz [not null, note: '''확인 시각
예: 2026-11-27 04:00:05+09''']
  passed boolean [not null, note: '''통과 여부
예: true''']
  threshold double [note: '''통과 기준 코사인
예: 0.995''']
  min_cosine double [note: '''사진 중 가장 낮은 코사인
예: 0.9991''']
  photo_count int [note: '''비교한 사진 수
예: 20''']
  created_reference boolean [note: '''이번에 기준을 새로 만들었는지
예: false''']
  reference_created_at string [note: '''기준을 만든 시각
예: 2026-11-20T10:02:00+09:00''']
  detail string [note: '''사진별 코사인·사용량 JSON
예: {"cosines":[0.9998,0.9991]}''']
  gold_updated_at timestamptz [note: '''기록 시각
예: 2026-11-27 04:00:09+09''']
}

// ───────── 영역 (TableGroup) ─────────
TableGroup gold [color: #C2185B, note: 'Gold 층. 실행 입력·버전 레지스트리, 공용 처리·요청 로그, 태그·사진 벡터·글 벡터 결과, canary. 연결 키는 sha256(사진), desertion_no(공고), gold_run_id(실행), task@N(버전), publish_id(입력 발행본)'] {
  gold_run_input
  gold_version_registry
  gold_inference_log
  gold_model_request_log
  gold_animal_tag
  gold_image_embedding
  gold_text_embedding
  gold_embedding_canary
}
