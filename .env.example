# 실제 값은 .env 에 넣는다. 이 파일에는 이름과 예시만 둔다.

# 공공데이터포털 인증키 (scripts/rescue/ 에서 사용)
DATA_GO_KR_SERVICE_KEY=

# 검색 API 데이터 모드: sample(샘플 JSON) | db(아직 미구현)
REBOM_DATA_MODE=sample
# sample 모드에서 읽을 파일. 비우면 data/sample/rescue_sample.json
# REBOM_SAMPLE_PATH=
# CORS 허용 출처 (쉼표 구분)
REBOM_CORS_ORIGINS=http://localhost:3000
