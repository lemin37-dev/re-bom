# 실제 값은 .env 에 넣는다. 이 파일에는 이름과 예시만 둔다.

# 공공데이터포털 인증키 (scripts/rescue/ 와 src/rebom/ingestion/ 에서 사용)
DATA_GO_KR_SERVICE_KEY=

# 증분 수집 결과를 올릴 S3 버킷. 비우면 로컬 data/ 에 저장한다 (src/rebom/ingestion/storage.py).
# AWS 자격증명은 여기에 두지 않고 환경(역할, AWS_* 환경변수, ~/.aws)에서 읽는다.
REBOM_S3_BUCKET=
# 버킷 안의 접두사 (선택). 비우면 버킷 루트
# REBOM_S3_PREFIX=

# 검색 API 데이터 모드: sample(샘플 JSON) | db(아직 미구현)
REBOM_DATA_MODE=sample
# sample 모드에서 읽을 파일. 비우면 data/sample/rescue_sample.json
# REBOM_SAMPLE_PATH=
# CORS 허용 출처 (쉼표 구분)
# 같은 Wi-Fi의 휴대폰에서 테스트하면 PC 주소도 추가: http://192.168.0.10:3000
REBOM_CORS_ORIGINS=http://localhost:3000

# Gemini Embedding 2 API 키 (src/rebom/embedding/gemini.py). 유료 등급 키를 쓴다
GEMINI_API_KEY=
