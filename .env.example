# 실제 값은 .env 에 넣는다. 이 파일에는 이름과 예시만 둔다.

# 공공데이터포털 인증키 (scripts/rescue/ 와 src/rebom/ingestion/ 에서 사용)
DATA_GO_KR_SERVICE_KEY=

# 국가법령정보센터 Open API 신청 ID(OC) (open.law.go.kr. 자치법규에서 입양 지원 조례가 있는 지자체 찾기)
Law_open_data=

# 문화 공공데이터광장(api.kcisa.kr) 인증키 (지역축제정보. data.go.kr 키와 다름, 메일로 발급)
KCISA_API_KEY=

# 지방재정365 Open API 인증키 (lofin365.go.kr 에서 따로 발급. 입양 지원 예산이 잡힌 지자체 찾기)
LOFIN365_API_KEY=

# 카카오 (developers.kakao.com, 앱 RE:봄). REST 키는 서버에서만(허용 IP 등록), JavaScript 키는 frontend/.env.local 의 NEXT_PUBLIC_KAKAO_JS_KEY 로도 씀
kakao_rest_api=
kakao_java_api=

# 증분 수집 결과를 올릴 S3 버킷. 비우면 로컬 data/ 에 저장한다 (src/rebom/ingestion/storage.py).
# AWS 자격증명은 여기에 두지 않고 환경(역할, AWS_* 환경변수, ~/.aws)에서 읽는다.
REBOM_S3_BUCKET=
# 버킷 안의 접두사 (선택). 비우면 버킷 루트
# REBOM_S3_PREFIX=

# 검색 API 데이터 모드: sample(샘플 JSON) | db(RDS 서비스 표)
REBOM_DATA_MODE=sample
# 실행 환경: prod(기본) | dev. dev 면 검색 결과마다 순위 근거(필터·태그 단계·벡터 거리·정렬값)를 응답 rank·debug 에 넣고
# 프론트 카드에도 보인다(serving/rank_debug.py). 로컬 개발에서만 dev 로 두고, 배포에는 넣지 않는다
# REBOM_ENV=dev
# db 모드일 때만: 로컬 시험용 접속 문자열(비우면 Secrets Manager), 사진 주소 앞부분(비우면 /images/... 상대 주소)
# REBOM_DB_DSN=
# REBOM_IMAGE_BASE_URL=
# sample 모드에서 읽을 파일. 비우면 data/sample/rescue_sample.json
# REBOM_SAMPLE_PATH=
# CORS 허용 출처 (쉼표 구분)
# 같은 Wi-Fi의 휴대폰에서 테스트하면 PC 주소도 추가: http://192.168.0.10:3000
REBOM_CORS_ORIGINS=http://localhost:3000
# 운영 화면(/ops) 로그인 (db 모드에서만 열림). 둘 다 있어야 열리고, 없으면 /ops 만 503.
# 해시는 python -m rebom.serving.ops_auth hash, 서명 키는 python -m rebom.serving.ops_auth secret 으로 만든다
# REBOM_OPS_PASSWORD_HASH=
# REBOM_OPS_SESSION_SECRET=
# 로컬 http 로 시험할 때만 false (기본 true: 쿠키를 https 로만 보냄)
# REBOM_OPS_COOKIE_SECURE=false
# 기록의 환경(test|prod). 비우면 test
# REBOM_OPS_ENV=

# 사진 임베딩 (src/rebom/embedding). 키는 GEMINI_API_KEY → .env → Secrets Manager 순서로 찾는다.
# 유료 등급 키를 쓴다. 서버에서는 비우고 Secrets Manager(노드 역할)에서 읽는다.
# sk-or- 로 시작하는 OpenRouter 키면 OpenRouter(google/gemini-embedding-2)로, 아니면 Google 로 직접 보낸다.
GEMINI_API_KEY=
# Gemini 키 시크릿 이름. 기본은 서버 운영 전용 rebom/embed/prod/gemini_api_key
# (값이 JSON 이면 GEMINI_API_KEY·gemini_api_key·api_key·key 중 처음 있는 필드, 필드가 하나뿐이면 그 값)
# REBOM_GEMINI_SECRET_ID=
# OpenRouter 비용 구분 표시(누가·어디서). 예: rebom-embed:local:<이름>. 기본 rebom-embed:local
# REBOM_USAGE_TAG=
# 서비스 DB 접속 시크릿. 기본 rebom/dev/rebom-db
# REBOM_DB_SECRET_ID=
# 내 PC 에서 SSM 포트포워딩으로 RDS 에 붙을 때만 (예: 127.0.0.1 / 15432)
# REBOM_DB_HOST=
# REBOM_DB_PORT=
# OpenRouter 이미지 태깅 키 (src/rebom/tagging/). PC는 rebom-tag-img-dev, k3s Secret 은 rebom-tag-img-prod
OPENROUTER_KEY_TAG_IMG=
# OpenRouter Jev 글 태깅 키 (src/rebom/tagging/run_text_tags.py). PC 시험은 로컬 테스트 키.
# 운영 키는 Secrets Manager rebom/tag/prod/jev_api_key (run --key-source secrets, 서버는 노드 역할). 다른 이름이면 REBOM_JEV_SECRET_ID
OPENROUTER_KEY_TAG_JEV=
