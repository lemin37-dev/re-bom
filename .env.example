# 실제 값은 .env 에 넣는다. 이 파일에는 이름과 예시만 둔다.

# 공공데이터포털 인증키 (scripts/rescue/ 와 src/rebom/ingestion/ 에서 사용)
DATA_GO_KR_SERVICE_KEY=

# 증분 수집 결과를 올릴 S3 버킷. 비우면 로컬 data/ 에 저장한다 (src/rebom/ingestion/storage.py).
# AWS 자격증명은 여기에 두지 않고 환경(역할, AWS_* 환경변수, ~/.aws)에서 읽는다.
REBOM_S3_BUCKET=
# 버킷 안의 접두사 (선택). 비우면 버킷 루트
# REBOM_S3_PREFIX=

# 검색 API 데이터 모드: sample(샘플 JSON) | db(아직 미구현)
REBOM_DATA_MODE=sample
# sample 모드에서 읽을 파일. 비우면 data/sample/rescue_sample.json
# REBOM_SAMPLE_PATH=
# CORS 허용 출처 (쉼표 구분)
# 같은 Wi-Fi의 휴대폰에서 테스트하면 PC 주소도 추가: http://192.168.0.10:3000
REBOM_CORS_ORIGINS=http://localhost:3000

# 사진 임베딩 (src/rebom/embedding). 키는 GEMINI_API_KEY → .env → Secrets Manager 순서로 찾는다.
# 유료 등급 키를 쓴다. 서버에서는 비우고 Secrets Manager(노드 역할)에서 읽는다.
# sk-or- 로 시작하는 OpenRouter 키면 OpenRouter(google/gemini-embedding-2)로, 아니면 Google 로 직접 보낸다.
GEMINI_API_KEY=
# Gemini 키 시크릿 이름. 기본은 서버 운영 전용 rebom/embed/prod/gemini_api_key
# (값이 JSON 이면 GEMINI_API_KEY·gemini_api_key·api_key·key 중 처음 있는 필드, 필드가 하나뿐이면 그 값)
# REBOM_GEMINI_SECRET_ID=
# OpenRouter 비용 구분 표시(누가·어디서). 예: rebom-embed:local:<이름>. 기본 rebom-embed:local
# REBOM_USAGE_TAG=
# 서비스 DB 접속 시크릿. 기본 rebom/dev/rebom-db
# REBOM_DB_SECRET_ID=
# 내 PC 에서 SSM 포트포워딩으로 RDS 에 붙을 때만 (예: 127.0.0.1 / 15432)
# REBOM_DB_HOST=
# REBOM_DB_PORT=
# OpenRouter 이미지 태깅 키 (src/rebom/tagging/). PC는 rebom-tag-img-dev, k3s Secret 은 rebom-tag-img-prod
OPENROUTER_KEY_TAG_IMG=
# OpenRouter Jev 글 태깅 키 (src/rebom/tagging/run_text_tags.py). PC 시험은 로컬 테스트 키, k3s Secret 은 rebom-tag-jev-prod
OPENROUTER_KEY_TAG_JEV=
